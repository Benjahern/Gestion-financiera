worker_processes 2;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  server_tokens off;
  sendfile on;
  client_max_body_size 16k;
  client_body_timeout 10s;
  client_header_timeout 10s;
  keepalive_timeout 30s;
  client_body_temp_path /tmp/client_body;
  proxy_temp_path /tmp/proxy;
  fastcgi_temp_path /tmp/fastcgi;
  uwsgi_temp_path /tmp/uwsgi;
  scgi_temp_path /tmp/scgi;
  # Never log query strings, OAuth codes, cookies, request bodies or emails.
  log_format safe '$remote_addr $request_method $uri $status $body_bytes_sent';
  access_log /dev/stdout safe;
  resolver 127.0.0.11 valid=30s ipv6=off;
  map $uri $auth_key {
    default '';
    ~^/api/auth/(?:start|login|activate|recover)$ $binary_remote_addr;
  }
  limit_req_zone $auth_key zone=auth:10m rate=10r/m;
  limit_req_zone $server_name zone=api_global:1m rate=30r/s;
  limit_req_status 429;
  map $uri $cache_control {
    default 'no-store';
    ~^/assets/ 'public, max-age=31536000, immutable';
  }
  map $uri $csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";
    ~^/api/ "default-src 'none'; frame-ancestors 'none'";
  }
  server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Trust only the explicitly configured Coolify/ingress subnet, never all IPs.
    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    add_header Cache-Control $cache_control always;
    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    location = /healthz { access_log off; return 200 'ok\n'; }
    location ~ ^/(?:\.|@|src(?:/|$)|node_modules(?:/|$)|(?:package|pnpm-lock|pnpm-workspace|docker-compose|vite\.config|tsconfig)) {
      return 404;
    }
    location ~* \.(?:xlsx|xls|xlsm|ods|csv|sql|dump|backup|pem|key|map)$ { return 404; }
    location /api/ {
      limit_req zone=api_global burst=60 nodelay;
      limit_req zone=auth burst=10 nodelay;
      set $backend http://backend:8080;
      proxy_pass $backend$request_uri;
      proxy_http_version 1.1;
      proxy_set_header Connection '';
      proxy_set_header Host $host;
      proxy_set_header X-Orden-Proxy-Secret '${INTERNAL_PROXY_SECRET}';
      proxy_set_header X-Orden-Client-IP $remote_addr;
      # Do not relay user-supplied proxy identity headers to the backend.
      proxy_set_header X-Forwarded-For '';
      proxy_set_header X-Real-IP '';
      proxy_set_header Forwarded '';
      proxy_hide_header Cache-Control;
      proxy_hide_header Content-Security-Policy;
      proxy_hide_header X-Frame-Options;
      proxy_hide_header X-Content-Type-Options;
      proxy_hide_header Referrer-Policy;
      proxy_hide_header Strict-Transport-Security;
      proxy_connect_timeout 5s;
      proxy_read_timeout 90s;
      proxy_send_timeout 15s;
    }
    location /assets/ { try_files $uri =404; }
    location / {
      if ($request_method !~ ^(?:GET|HEAD)$) { return 405; }
      try_files $uri $uri/ /index.html;
    }
  }
}
