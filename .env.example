# Documentation only. Set these as runtime variables in Coolify, not build arguments.
APP_ORIGIN=https://orden.example.com
OWNER_EMAIL=owner@example.invalid
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
# openssl rand -hex 32 (different from the database passwords)
INTERNAL_PROXY_SECRET=
# Exact trusted ingress address/subnet. The default trusts no Docker proxy.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Optional Gmail: leave all three empty until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# openssl rand -base64 32; preserve it for the lifetime of Gmail connections.
TOKEN_ENCRYPTION_KEY=
